# Copy to .env.local (never commit real values).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# "on" sends a confirmation email at sign-up (needs custom SMTP in Supabase).
# Anything else creates accounts straight away from the sign-up form.
SIGNUP_EMAIL_CONFIRMATION=
# Vercel cron authentication (random 32+ chars)
CRON_SECRET=
# Owner's Claude key for shared world text (M3)
ANTHROPIC_API_KEY=
# Signs the database's request to wake the AI worker. Any long random string.
MINDS_SECRET=
# Master key for encrypting player AI keys (M2): 32 random bytes, base64
BYOK_KEK=
